{
  "name": "@watercolor/shapes",
  "version": "0.1.0",
  "description": "Physically-inspired watercolour rendering of SVG path shapes.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/watercolor-shapes.js",
  "module": "./dist/watercolor-shapes.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/watercolor-shapes.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx test/run.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.5"
  }
}